{
  "name": "mahiron",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @mahiron/server",
    "dev:web": "npm run dev --workspace @mahiron/web",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run check && npm test",
    "probe": "npm run probe --workspace @mahiron/server --",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
