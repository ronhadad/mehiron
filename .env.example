# The web app's environment. Locally: web/.env.local. On Vercel: project settings.
#
# All three are required. With APP_PASSWORD or AUTH_SECRET missing the app
# refuses every request rather than serving an open one.

# A hosted Postgres in production; the local Docker instance in development.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/mahiron_web?schema=public"

# The single sign-in password.
APP_PASSWORD="choose-something-long"

# Signs the session cookie. Any long random string: openssl rand -base64 32
AUTH_SECRET="generate-me"
